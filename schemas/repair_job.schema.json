{
  "$defs": {
    "AuditIssue": {
      "properties": {
        "issue_code": {
          "$ref": "#/$defs/IssueCode"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "validator": {
          "title": "Validator",
          "type": "string"
        },
        "validator_version": {
          "title": "Validator Version",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "issue_code",
        "severity",
        "reason",
        "confidence",
        "evidence_type",
        "evidence",
        "validator",
        "validator_version",
        "created_at"
      ],
      "title": "AuditIssue",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "STATIC_ANALYSIS",
        "NETWORK_FETCH",
        "HEURISTIC",
        "LLM",
        "COMPILER",
        "NONE"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "IssueCode": {
      "enum": [
        "CODE_FILE_MISSING",
        "METADATA_FILE_MISSING",
        "ORPHAN_CODE_FILE",
        "ORPHAN_METADATA_FILE",
        "UNEXPECTED_EXTENSION",
        "UNEXPECTED_PATH",
        "ENCODING_INVALID",
        "BINARY_CONTENT",
        "CODE_EMPTY",
        "CODE_TOO_SMALL",
        "CODE_SUSPICIOUS_SIZE",
        "CODE_TRUNCATED",
        "CODE_SYNTAX_INVALID",
        "CODE_LANGUAGE_MISMATCH",
        "CODE_COMPILATION_FAILED",
        "METADATA_MISSING",
        "METADATA_INVALID",
        "METADATA_INCONSISTENT",
        "METADATA_SCHEMA_INVALID",
        "SOURCE_MISSING",
        "SOURCE_URL_MALFORMED",
        "SOURCE_REPOSITORY_MISMATCH",
        "SOURCE_UNAVAILABLE",
        "SOURCE_FILE_NOT_FOUND",
        "SOURCE_CONTENT_MISMATCH",
        "SOURCE_CHANGED",
        "LICENSE_MISSING",
        "LICENSE_UNVERIFIED",
        "LICENSE_UNKNOWN",
        "LICENSE_CONFLICT",
        "PROVENANCE_MISSING",
        "PROVENANCE_INCOMPLETE",
        "AUTHOR_MISSING",
        "AUTHOR_UNVERIFIED",
        "COMMIT_METADATA_MISSING",
        "DATE_METADATA_MISSING",
        "DUPLICATE_EXACT",
        "DUPLICATE_NORMALIZED",
        "DUPLICATE_NEAR",
        "PROBLEM_SOLUTION_MISMATCH",
        "PROBLEM_MATCH_UNCERTAIN",
        "SOURCE_PROBLEM_MISMATCH",
        "GENERATED_MARKER_FOUND",
        "GENERATED_CODE_SUSPECTED"
      ],
      "title": "IssueCode",
      "type": "string"
    },
    "Language": {
      "enum": [
        "C",
        "C++",
        "Java",
        "JavaScript",
        "Python"
      ],
      "title": "Language",
      "type": "string"
    },
    "RepairClass": {
      "enum": [
        "SAFE_DETERMINISTIC_REPAIR",
        "LLM_ASSISTED_REPAIR",
        "SOURCE_REFETCH_REQUIRED",
        "HUMAN_REVIEW_REQUIRED",
        "DO_NOT_REPAIR"
      ],
      "title": "RepairClass",
      "type": "string"
    },
    "RepairStatus": {
      "enum": [
        "SUCCESS",
        "FAIL",
        "PENDING"
      ],
      "title": "RepairStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "properties": {
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "solution_id": {
      "title": "Solution Id",
      "type": "string"
    },
    "problem_id": {
      "title": "Problem Id",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "$ref": "#/$defs/Language"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "original_code_path": {
      "title": "Original Code Path",
      "type": "string"
    },
    "original_metadata_path": {
      "title": "Original Metadata Path",
      "type": "string"
    },
    "original_code_sha256": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Original Code Sha256",
      "type": "string"
    },
    "original_metadata_sha256": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Original Metadata Sha256",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/AuditIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "recommended_action": {
      "title": "Recommended Action",
      "type": "string"
    },
    "repair_class": {
      "$ref": "#/$defs/RepairClass"
    },
    "repair_allowed": {
      "title": "Repair Allowed",
      "type": "boolean"
    },
    "verification_required": {
      "title": "Verification Required",
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/RepairStatus"
    },
    "pipeline_version": {
      "title": "Pipeline Version",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "solution_id",
    "problem_id",
    "original_code_path",
    "original_metadata_path",
    "original_code_sha256",
    "original_metadata_sha256",
    "recommended_action",
    "repair_class",
    "repair_allowed",
    "verification_required",
    "status",
    "pipeline_version",
    "created_at"
  ],
  "title": "RepairJob",
  "type": "object"
}