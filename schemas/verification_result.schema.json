{
  "$defs": {
    "DecisionStatus": {
      "enum": [
        "VERIFIED",
        "REJECTED",
        "UNCERTAIN",
        "HUMAN_REVIEW_REQUIRED",
        "NOT_VERIFIED"
      ],
      "title": "DecisionStatus",
      "type": "string"
    },
    "VerificationStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_AVAILABLE",
        "NOT_APPLICABLE",
        "UNCERTAIN"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "properties": {
    "integrity": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "NOT_APPLICABLE"
    },
    "encoding": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "NOT_APPLICABLE"
    },
    "language": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "NOT_APPLICABLE"
    },
    "syntax": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "NOT_APPLICABLE"
    },
    "compilation": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "NOT_APPLICABLE"
    },
    "execution": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "NOT_APPLICABLE"
    },
    "problem_matching": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "NOT_APPLICABLE"
    },
    "metadata": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "NOT_APPLICABLE"
    },
    "provenance": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "NOT_APPLICABLE"
    },
    "diff": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "NOT_APPLICABLE"
    },
    "overall_decision": {
      "$ref": "#/$defs/DecisionStatus"
    }
  },
  "required": [
    "overall_decision"
  ],
  "title": "VerificationResult",
  "type": "object"
}